# ──────────────────────────────────────────────────────────────────────────────────────────────
# MODÈLE de configuration locale — AUCUNE VALEUR RÉELLE ICI.
#
# COPIER CE FICHIER en « .env » DANS CE MÊME DOSSIER (la racine du projet), puis y renseigner
# les valeurs. C'est l'emplacement exact que lisent :
#   · l'application  — app/services/hostaway_cleaning_tasks_actualisation_service.py
#                      load_dotenv(Path(cfg.PROJECT_ROOT) / ".env")
#   · le moteur      — 02_TRAVAIL/lot1_hostaway_extract.py
#                      ENV_FILE = BASE_DIR / ".env"
# Les deux pointent le même fichier : il n'existe pas deux configurations à tenir à jour.
#
# `.env` est ignoré par Git (voir .gitignore) et ne doit JAMAIS être commité. C'est aussi la
# raison pour laquelle il n'est pas présent après la création d'un nouveau worktree : les
# fichiers ignorés ne sont pas copiés. Un worktree neuf démarre donc sans identifiants, et
# l'application répond « Identifiants Hostaway absents » — ce n'est pas une perte de données,
# c'est un fichier local qui n'a jamais été recopié.
#
# Les valeurs ne sont jamais journalisées ni affichées par l'application.
# ──────────────────────────────────────────────────────────────────────────────────────────────

# ── Hostaway ───────────────────────────────────────────────────────────────────────────────────
# LAISSER VIDE. Ces variables ne sont PAS requises sur une installation normale.
#
# Les RÉSERVATIONS et leurs champs financiers sont extraits par le pipeline GitHub Actions
# (« Hostaway Pipeline », branche `main`), qui détient le jeton dans les Secrets du dépôt et publie
# le résultat trois fois par jour. L'application se contente de synchroniser ce dernier jeu publié :
# elle n'appelle jamais Hostaway, et n'a donc aucun secret à stocker ici.
#
# Recopier des identifiants Hostaway sur ce poste créerait une SECONDE chaîne d'ingestion pour la
# même donnée. Deux extracteurs finissent toujours par se comporter différemment, et plus rien ne
# dit lequel a produit ce que l'écran affiche.
#
# Les TÂCHES DE MÉNAGE (`/v1/tasks`) sont extraites par un workflow GitHub dédié, que l'application
# déclenche elle-même (voir « Actualisation des ménages » ci-dessous) — là encore, aucun secret
# Hostaway sur ce poste.
HOSTAWAY_CLIENT_ID=
HOSTAWAY_CLIENT_SECRET=
HOSTAWAY_ACCOUNT_ID=
HOSTAWAY_BASE_URL=https://api.hostaway.com

# ── Actualisation des ménages : workflow GitHub des tâches de ménage ────────────────────────────
# « Actualiser les ménages » déclenche le workflow « HOSTAWAY — CLEANING TASKS ONLY », retrouve SON
# run par son titre, lit SON artifact `cleaning-tasks-output` (cleaning_tasks_hostaway.tsv), puis
# rapproche. Ni `git pull`, ni lecture du contenu du dépôt : uniquement l'API Actions.
#
# HOSTAWAY_GITHUB_TOKEN — jeton GitHub À GRAIN FIN (fine-grained personal access token) :
#   · Repository access : « Only select repositories » → eschmitt27/hostaway-reporting, rien d'autre ;
#   · Repository permissions → Actions : « Read and write »
#       (write : déclencher le workflow ; read : lire les runs et télécharger les artifacts) ;
#   · Metadata : « Read-only » (imposée automatiquement par GitHub) ;
#   · AUCUNE autre permission — en particulier pas « Contents ».
# Le jeton ne quitte jamais ce fichier : jamais en base, jamais affiché, jamais journalisé.
# Absent : le bouton répond « l'actualisation Hostaway a échoué », les données actuelles restent.
HOSTAWAY_GITHUB_REPOSITORY=eschmitt27/hostaway-reporting
HOSTAWAY_GITHUB_WORKFLOW=hostaway-cleaning-tasks.yml
HOSTAWAY_GITHUB_REF=main
HOSTAWAY_GITHUB_TOKEN=

# Dépôt portant les données publiées. Valeurs par défaut : le remote et la branche du projet —
# le dépôt de données EST le dépôt du projet, donc aucune authentification supplémentaire.
HOSTAWAY_DEPOT_REMOTE=origin
HOSTAWAY_DEPOT_BRANCHE=main

# ── Interpréteur des lots moteur ───────────────────────────────────────────────────────────────
# Le défaut codé (« C:\Program Files\Python312\python.exe ») n'existe pas sur toutes les
# machines : sans cette variable, tout lot répond « Interpréteur des lots introuvable ».
# Pointer le Python du venv du projet.
LOT4A_ENGINE_PYTHON=
MENAGES_ENGINE_PYTHON=
PILOTAGE_ENGINE_PYTHON=

# ── Serveur local ──────────────────────────────────────────────────────────────────────────────
PORT=8000
LOG_LEVEL=info

# ── Identité légale de la société émettrice (factures) ─────────────────────────────────────────
# SOCIETE_SIRET et SOCIETE_TVA_INTRA restent VIDES tant que ces numéros ne sont pas connus :
# ils ne sont alors simplement pas imprimés. Ne jamais en fabriquer.
SOCIETE_NOM=
SOCIETE_FORME_JURIDIQUE=
SOCIETE_CAPITAL=
SOCIETE_ADRESSE=
SOCIETE_SIREN=
SOCIETE_SIRET=
SOCIETE_RCS=
SOCIETE_TVA_INTRA=
SOCIETE_REPRESENTANTS=
SOCIETE_CONTACT=

# ── Facturation ────────────────────────────────────────────────────────────────────────────────
# FACTURATION_DELAI_PAIEMENT_JOURS : 0 = paiement à réception (échéance = date d'émission).
# Vide = non configuré, et l'émission est bloquée — les deux ne sont pas la même chose.
FACTURATION_REGIME_TVA=
FACTURATION_MENTION_FRANCHISE_TVA=
FACTURATION_DELAI_PAIEMENT_JOURS=
FACTURATION_CONDITIONS_ESCOMPTE=
# Exigées uniquement pour émettre vers un client PROFESSIONNEL. Aucune valeur par défaut n'est
# codée : une valeur métier incertaine écrite en dur serait invisible et fausse.
FACTURATION_TAUX_PENALITES_RETARD=
FACTURATION_INDEMNITE_RECOUVREMENT=

# ── Mode réel (écritures) ──────────────────────────────────────────────────────────────────────
# Verrou à deux leviers : un writer n'écrit que si (RECETTE_MODE ou MODE_REEL_ECRITURES) ET sa
# propre variable sont posés. Voir GUIDE_ACTIVATION_MODE_REEL.md.
MODE_REEL_ECRITURES=
CHARGES_REAL_WRITE_ENABLED=
CHARGES_REAL_WRITE_CONFIRMATION_ENABLED=
FACTURES_REAL_WRITE_ENABLED=
FACTURES_REAL_WRITE_CONFIRMATION_ENABLED=
MENAGES_CYCLE_REAL_WRITE_ENABLED=
MENAGES_CYCLE_REAL_WRITE_CONFIRMATION_ENABLED=
COMPTABILITE_REAL_WRITE_ENABLED=
COMPTABILITE_REAL_WRITE_CONFIRMATION_ENABLED=
BANQUE_REAL_WRITE_ENABLED=
BANQUE_REAL_WRITE_CONFIRMATION_ENABLED=

# ── Ordonnanceur Hostaway ──────────────────────────────────────────────────────────────────────
# Rafraîchissement automatique. Inerte tant que ORDONNANCEUR_ACTIF n'est pas posé à 1 :
# l'activer est une décision d'exploitation, jamais un effet de bord d'un déploiement.
ORDONNANCEUR_ACTIF=
HOSTAWAY_REFRESH_INTERVAL_HOURS=5
HOSTAWAY_CLEANING_TASKS_INTERVAL_HOURS=24

# ── Qonto (banque) — LECTURE SEULE ─────────────────────────────────────────────────────────────
# Clé d'API Qonto : Qonto > Intégrations et partenariats > Clé d'API.
# `QONTO_LOGIN` est l'identifiant (« sign-in ») de l'organisation, `QONTO_SECRET_KEY` la clé.
# L'application les concatène en `Authorization: {login}:{secret}` — sans Base64, ce n'est pas du
# Basic Auth malgré la ressemblance.
#
# Le client bancaire est STRICTEMENT GET : il refuse POST/PUT/PATCH/DELETE avant toute sortie
# réseau. Aucun virement, aucune catégorisation, aucune écriture côté Qonto n'est possible depuis
# cette application — déposer ces identifiants ici ne donne pas ce pouvoir.
#
# Ces valeurs ne sont jamais journalisées, jamais écrites en base, jamais affichées.
QONTO_LOGIN=
QONTO_SECRET_KEY=

# ── Chargement de ce fichier ───────────────────────────────────────────────────────────────────
# L'application lit ce fichier AU DÉMARRAGE (app/config.py), avant d'évaluer ses variables.
# Une vraie variable d'environnement — posée par le serveur, un conteneur ou une CI — GAGNE
# toujours sur ce fichier : il complète l'environnement, il ne le remplace pas.
# Un fichier absent est normal (il est ignoré par Git) : l'application démarre, et les
# fonctionnalités qui exigent un identifiant le signalent au moment voulu.
#
# PILOTAGE_IGNORE_ENV_FILE=1 fait ignorer ce fichier entièrement. Réservé aux tests de sûreté et
# aux CI qui doivent garantir que SEULES les vraies variables d'environnement comptent.
PILOTAGE_IGNORE_ENV_FILE=

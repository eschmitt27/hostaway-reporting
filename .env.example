# ──────────────────────────────────────────────────────────────────────────────────────────────
# MODÈLE de configuration locale — AUCUNE VALEUR RÉELLE ICI.
#
# COPIER CE FICHIER en « .env » DANS CE MÊME DOSSIER (la racine du projet), puis y renseigner
# les valeurs. C'est l'emplacement exact que lisent :
#   · l'application  — app/services/hostaway_cleaning_tasks_actualisation_service.py
#                      load_dotenv(Path(cfg.PROJECT_ROOT) / ".env")
#   · le moteur      — 02_TRAVAIL/lot1_hostaway_extract.py
#                      ENV_FILE = BASE_DIR / ".env"
# Les deux pointent le même fichier : il n'existe pas deux configurations à tenir à jour.
#
# `.env` est ignoré par Git (voir .gitignore) et ne doit JAMAIS être commité. C'est aussi la
# raison pour laquelle il n'est pas présent après la création d'un nouveau worktree : les
# fichiers ignorés ne sont pas copiés. Un worktree neuf démarre donc sans identifiants, et
# l'application répond « Identifiants Hostaway absents » — ce n'est pas une perte de données,
# c'est un fichier local qui n'a jamais été recopié.
#
# Les valeurs ne sont jamais journalisées ni affichées par l'application.
# ──────────────────────────────────────────────────────────────────────────────────────────────

# ── Hostaway (réservations et tâches de ménage) ────────────────────────────────────────────────
# Sans ces trois valeurs, l'actualisation Hostaway et le rapprochement des ménages s'arrêtent
# AVANT tout appel réseau, avec un message explicite. Les obtenir depuis le compte Hostaway :
# Settings → Hostaway API.
HOSTAWAY_CLIENT_ID=
HOSTAWAY_CLIENT_SECRET=
HOSTAWAY_ACCOUNT_ID=
HOSTAWAY_BASE_URL=https://api.hostaway.com

# ── Interpréteur des lots moteur ───────────────────────────────────────────────────────────────
# Le défaut codé (« C:\Program Files\Python312\python.exe ») n'existe pas sur toutes les
# machines : sans cette variable, tout lot répond « Interpréteur des lots introuvable ».
# Pointer le Python du venv du projet.
LOT4A_ENGINE_PYTHON=
MENAGES_ENGINE_PYTHON=
PILOTAGE_ENGINE_PYTHON=

# ── Serveur local ──────────────────────────────────────────────────────────────────────────────
PORT=8000
LOG_LEVEL=info

# ── Identité légale de la société émettrice (factures) ─────────────────────────────────────────
# SOCIETE_SIRET et SOCIETE_TVA_INTRA restent VIDES tant que ces numéros ne sont pas connus :
# ils ne sont alors simplement pas imprimés. Ne jamais en fabriquer.
SOCIETE_NOM=
SOCIETE_FORME_JURIDIQUE=
SOCIETE_CAPITAL=
SOCIETE_ADRESSE=
SOCIETE_SIREN=
SOCIETE_SIRET=
SOCIETE_RCS=
SOCIETE_TVA_INTRA=
SOCIETE_REPRESENTANTS=
SOCIETE_CONTACT=

# ── Facturation ────────────────────────────────────────────────────────────────────────────────
# FACTURATION_DELAI_PAIEMENT_JOURS : 0 = paiement à réception (échéance = date d'émission).
# Vide = non configuré, et l'émission est bloquée — les deux ne sont pas la même chose.
FACTURATION_REGIME_TVA=
FACTURATION_MENTION_FRANCHISE_TVA=
FACTURATION_DELAI_PAIEMENT_JOURS=
FACTURATION_CONDITIONS_ESCOMPTE=
# Exigées uniquement pour émettre vers un client PROFESSIONNEL. Aucune valeur par défaut n'est
# codée : une valeur métier incertaine écrite en dur serait invisible et fausse.
FACTURATION_TAUX_PENALITES_RETARD=
FACTURATION_INDEMNITE_RECOUVREMENT=

# ── Mode réel (écritures) ──────────────────────────────────────────────────────────────────────
# Verrou à deux leviers : un writer n'écrit que si (RECETTE_MODE ou MODE_REEL_ECRITURES) ET sa
# propre variable sont posés. Voir GUIDE_ACTIVATION_MODE_REEL.md.
MODE_REEL_ECRITURES=
CHARGES_REAL_WRITE_ENABLED=
CHARGES_REAL_WRITE_CONFIRMATION_ENABLED=
FACTURES_REAL_WRITE_ENABLED=
FACTURES_REAL_WRITE_CONFIRMATION_ENABLED=
MENAGES_CYCLE_REAL_WRITE_ENABLED=
MENAGES_CYCLE_REAL_WRITE_CONFIRMATION_ENABLED=
COMPTABILITE_REAL_WRITE_ENABLED=
COMPTABILITE_REAL_WRITE_CONFIRMATION_ENABLED=
BANQUE_REAL_WRITE_ENABLED=
BANQUE_REAL_WRITE_CONFIRMATION_ENABLED=

# ── Ordonnanceur Hostaway ──────────────────────────────────────────────────────────────────────
# Rafraîchissement automatique. Inerte tant que ORDONNANCEUR_ACTIF n'est pas posé à 1 :
# l'activer est une décision d'exploitation, jamais un effet de bord d'un déploiement.
ORDONNANCEUR_ACTIF=
HOSTAWAY_REFRESH_INTERVAL_HOURS=5
HOSTAWAY_CLEANING_TASKS_INTERVAL_HOURS=24

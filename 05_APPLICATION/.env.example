# Copier en .env et ajuster si besoin.
# En général, PROJECT_ROOT est déduit automatiquement depuis __file__ — ne modifier que si l'arborescence diffère.

PORT=8000
# PROJECT_ROOT est calculé automatiquement depuis l'emplacement de ce dossier.
# Forcer ici uniquement si nécessaire :
# PROJECT_ROOT=C:\Users\Ewan\OneDrive\Documents\Conciergerie\Pilotage_Conciergerie

READ_ONLY=1
LOG_LEVEL=info
